{
  "title": "GridPulse Pipeline",
  "uid":   "gridpulse-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total API Requests",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(gridpulse_api_requests_total)", "legendFormat": "Requests" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2, "type": "stat", "title": "API Request Rate (req/s)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(gridpulse_api_requests_total[1m]))", "legendFormat": "req/s" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 3, "type": "stat", "title": "Kafka Consumer Lag (total)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(kafka_consumergroup_lag)", "legendFormat": "Lag" }],
      "options": { "colorMode": "background", "graphMode": "area",
        "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":1000},{"color":"red","value":10000}] }
      }
    },
    {
      "id": 4, "type": "stat", "title": "Kafka Messages In/s",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(kafka_topic_partition_current_offset[1m]))", "legendFormat": "msg/s" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 5, "type": "timeseries", "title": "API Latency (p50 / p95)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gridpulse_api_latency_seconds_bucket[1m])) by (le,endpoint))", "legendFormat": "p50 {{endpoint}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(gridpulse_api_latency_seconds_bucket[1m])) by (le,endpoint))", "legendFormat": "p95 {{endpoint}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Kafka Consumer Lag by Group",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_consumergroup_lag", "legendFormat": "{{consumergroup}} · {{topic}} · p{{partition}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Kafka Topic Throughput (offsets/s)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 7 },
      "targets": [{ "expr": "rate(kafka_topic_partition_current_offset[1m])", "legendFormat": "{{topic}} · p{{partition}}" }]
    }
  ]
}
