# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_METER_READINGS=meter-readings
KAFKA_TOPIC_TARIFF_UPDATES=tariff-updates
KAFKA_TOPIC_ALERTS=alerts

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=gridpulse_secret

# Airflow uses a separate database on the same PostgreSQL instance
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_secret

# ── Simulation clock ─────────────────────────────────────────────────────────
# 1 simulated day = SIMULATED_DAY_SECONDS real seconds (300 = 5 minutes)
SIMULATED_DAY_SECONDS=300
METER_EMIT_INTERVAL_MIN=2
METER_EMIT_INTERVAL_MAX=5
NUM_METERS=30
GRID_ZONES=ZONE_A,ZONE_B,ZONE_C

# ── Spark processing ──────────────────────────────────────────────────────────
RENEWABLE_ALERT_THRESHOLD=20.0
WINDOW_DURATION_SHORT=1 minute
WINDOW_DURATION_LONG=5 minutes
CHECKPOINT_DIR=/tmp/gridpulse-checkpoints

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__WEBSERVER__SECRET_KEY=gridpulse-secret-key-change-in-prod
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW_UID=50000
